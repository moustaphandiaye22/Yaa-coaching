# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public frontend origin served by the Docker Compose Nginx container
FRONTEND_ORIGIN=http://localhost:8080

# Initial administrator created by the idempotent Prisma seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate once with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Required in production by the API privacy configuration
SUBMISSION_RETENTION_DAYS=365
REVIEW_EMAIL_RETENTION_DAYS=90
