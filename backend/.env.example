# Neon Connect : utiliser l'URL poolée (-pooler) pour l'API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Prisma Migrate doit utiliser l'URL directe, sans -pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DATA_ENCRYPTION_KEY=
SUBMISSION_RETENTION_DAYS=365
REVIEW_EMAIL_RETENTION_DAYS=90
MEDIA_STORAGE_DIR=./var/media
