generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubmissionStatus {
  NEW
  TO_CONTACT
  CONTACTED
  IN_PROGRESS
  CLOSED
  REJECTED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum UserRole {
  ADMIN
  COACH
}

enum MediaKind {
  PHOTO
  VIDEO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  logs         AuditLog[]
  sessions     AuthSession[]
  submissionEvents SubmissionEvent[] @relation("SubmissionActor")
  contentRevisions ContentRevision[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Submission {
  id                 String           @id @default(cuid())
  service             String
  city                String
  contactName         String
  contactEmail        String
  contactPhone        String?
  contactNameIndex    String
  contactEmailIndex   String
  answers             Json
  consentAt           DateTime
  consentVersion      String           @default("v1")
  guardianConsentAt   DateTime?
  guardianConsentVersion String?
  questionnaireVersion String          @default("v1")
  idempotencyKey      String?          @unique
  status              SubmissionStatus @default(NEW)
  internalNotes       String           @default("")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  history             SubmissionEvent[]
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([contactNameIndex])
  @@index([contactEmailIndex])
}

model SubmissionEvent {
  id           String           @id @default(cuid())
  submissionId String
  actorId      String?
  action       String
  details      String?
  occurredAt   DateTime         @default(now())
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?            @relation("SubmissionActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model Review {
  id         String       @id @default(cuid())
  pseudonym  String
  service    String
  rating     Int
  message    String
  email      String
  emailIndex String
  status     ReviewStatus @default(PENDING)
  consentAt  DateTime
  consentVersion String   @default("v1")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@index([status, createdAt])
  @@index([emailIndex])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  position  Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@index([published, position])
}

model ContentBlock {
  id          String   @id @default(cuid())
  key         String   @unique
  content     Json
  publishedContent Json?
  revision    Int      @default(1)
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
  revisions   ContentRevision[]
}

model ContentRevision {
  id             String       @id @default(cuid())
  contentBlockId String
  revision       Int
  content        Json
  actorId        String?
  createdAt      DateTime     @default(now())
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@unique([contentBlockId, revision])
  @@index([createdAt])
}

model Media {
  id        String    @id @default(cuid())
  kind      MediaKind
  service   String
  url       String
  alt       String
  caption   String
  position  Int       @default(0)
  published Boolean   @default(false)
  updatedAt DateTime  @updatedAt
  @@index([published, position])
}

model Notification {
  id          String   @id @default(cuid())
  kind        String
  payload     Json
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lockedUntil DateTime?
  sentAt      DateTime?
  providerId  String?
  lastError   String?
  createdAt   DateTime @default(now())
  @@index([sentAt, availableAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  occurredAt DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([occurredAt])
}
